# PRISM API Backend Environment Variables
APP_NAME="PRISM API"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","https://prism-web.vercel.app"]

# LLM Provider Configuration ('mock' | 'gemini' | 'bedrock')
LLM_PROVIDER="mock"
GEMINI_API_KEY=""

# Vector & Relational Database (Supabase / PostgreSQL with pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prism"
SUPABASE_URL=""
SUPABASE_KEY=""
