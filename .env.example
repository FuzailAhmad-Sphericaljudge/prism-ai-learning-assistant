# PRISM Monorepo Environment Configuration Template
# Copy to .env for local orchestration or see web/.env.example and api/.env.example

NODE_ENV=development
ENVIRONMENT=development
PORT_WEB=3000
PORT_API=8000

# API URL used by frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend LLM & Database Settings
LLM_PROVIDER=mock
GEMINI_API_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prism
